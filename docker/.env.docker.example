# Docker Environment Configuration Example
# Copy this file to `.env` in the root directory if running `docker compose up`

PORT=5000
JWT_SECRET=super_secret_production_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=24h

# Supabase Credentials (optional: local fallback is used if not provided)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# MongoDB Name (database runs via local Docker container service)
MONGODB_DB_NAME=user_platform

# Firebase Admin SDK Credentials (optional: simulation mode if not provided)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# AI Insights (optional: analytical fallback if not provided)
GEMINI_API_KEY=
